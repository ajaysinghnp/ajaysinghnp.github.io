# AI Agent Environment Configuration
# This file provides examples of environment variables used in the project
# NEVER commit actual secrets to version control - use .env files for local development only

# GitHub API Configuration
GITHUB_TOKEN=your_github_token_here
GITHUB_API_URL=https://api.github.com

# Feedback form (n8n webhook)
N8N_FEEDBACK_WEBHOOK_URL=https://your-n8n-host/webhook/your-feedback-path
N8N_FEEDBACK_WEBHOOK_SECRET=your_shared_secret_here

# Application Configuration
NEXT_PUBLIC_APP_URL=https://your-domain.com
NEXT_PUBLIC_APP_NAME="Your App Name"

# Database Configuration (if applicable)
DATABASE_URL=postgresql://username:password@localhost:5432/database

# Cache Configuration
REDIS_URL=redis://localhost:6379

# File Upload Configuration
UPLOAD_DIR=/path/to/uploads
MAX_FILE_SIZE=10485760

# AI/ML Configuration
AI_MODEL_ENDPOINT=https://api.example.com/v1
AI_API_KEY=your_ai_api_key_here

# Monitoring & Analytics
SENTRY_DSN=your_sentry_dsn_here
ANALYTICS_ID=your_analytics_id_here

# Security
CORS_ORIGIN=https://your-domain.com
RATE_LIMIT_WINDOW_MS=900000

# Development
NODE_ENV=development
PORT=3000
HOST=localhost