# Server-only GitHub token with read access to public repositories.
# Never prefix this variable with NEXT_PUBLIC_.
GITHUB_TOKEN=
PORT=3000
NEXT_PUBLIC_SITE_URL=https://your-domain.example.com

# Branch the blog repo is read from (default: main)
BLOG_BRANCH=main

# Branch the cheatsheet repo is read from (default: main)
CHEATSHEET_BRANCH=main

GITHUB_WEBHOOK_SECRET=YOUR_SECRET_TO_REVALIDATE