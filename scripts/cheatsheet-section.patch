+export default function CheatsheetError({ reset }: { error: Error; reset: () => void }) {
+  const router = useRouter();
+  return (
+    <ProjectsState
+      label="The cheatsheets are temporarily unavailable."
+      description="GitHub may be limiting requests to its public API. Please try again shortly."
