diff --git a/components/content/section-pages.tsx b/components/content/section-pages.tsx
new file mode 100644
index 0000000..a33b26a
--- /dev/null
+++ b/components/content/section-pages.tsx
@@ -0,0 +1,182 @@
+import { notFound } from "next/navigation";
+
+import type { Metadata } from "next";
+
+import { Breadcrumbs } from "@/components/content/breadcrumbs";
+import { ContentIndex } from "@/components/content/content-index";
+import { PostView } from "@/components/content/post-view";
+import {
+  authorHref,
+  categoryCrumbs,
+  categoryLabel,
+  childCategories,
+  collectTags,
+  findAuthor,
+  plural,
+  tagSlug,
+} from "@/lib/content-format";
+import { getEntry, listAuthors, listEntries } from "@/lib/github-content";
+import type { ContentSection } from "@/types/blog";
+
+const capitalize = (value: string) => value.charAt(0).toUpperCase() + value.slice(1);
+
+/* ---------- index ---------- */
+
+export async function SectionIndex({ section }: { section: ContentSection }) {
+  const { source, basePath, page } = section;
+  const entries = await listEntries(source);
+
+  return (
+    <ContentIndex
+      entries={entries}
+      categories={childCategories(entries, "", source.labels)}
+      tags={collectTags(entries)}
+      labels={source.labels}
+      basePath={basePath}
+      eyebrow={page.eyebrow}
+      heading={page.heading}
+      intro={page.intro}
+      list={section.list}
+      itemLabel={section.itemLabel}
+    />
+  );
+}
+
+/* ---------- /<section>/a/b/c: a post if one exists, otherwise a category ---------- */
+
+async function resolve(section: ContentSection, path: string[]) {
+  const { source } = section;
+
+  if (path.length > 1) {
+    const entry = await getEntry(source, path[path.length - 1], path.slice(0, -1).join("/"));
+    if (entry) return { kind: "post" as const, entry };
+  }
+
+  // Hidden categories have no index page of their own, so only listed entries count here.
+  const category = path.join("/");
+  const all = await listEntries(source);
+  const entries = all.filter(
+    (e) => e.category === category || e.category.startsWith(`${category}/`),
+  );
+
+  return entries.length > 0 ? { kind: "category" as const, category, entries, all } : null;
+}
+
+export async function pathMetadata(section: ContentSection, path: string[]): Promise<Metadata> {
+  const { source } = section;
+  const resolved = await resolve(section, path);
+
+  if (!resolved) return { title: "Not found" };
+  if (resolved.kind === "category") {
+    return { title: categoryLabel(resolved.category, source.labels) };
+  }
+
+  const { entry } = resolved;
+  const { title, description, date, updated, author, tags } = entry.meta;
+
+  const authorList = await listAuthors(source);
+  const resolvedAuthor = findAuthor(authorList, author);
+
+  let authorMeta: Metadata["authors"];
+  if (resolvedAuthor) {
+    authorMeta = [
+      {
+        name: resolvedAuthor.name,
+        url: authorHref(section.authorBasePath ?? section.basePath, resolvedAuthor),
+      },
+    ];
+  } else if (author) {
+    authorMeta = [{ name: author }];
+  }
+
+  return {
+    title: title ?? entry.slug,
+    description,
+    authors: authorMeta,
+    keywords: tags,
+    robots: entry.hidden ? { index: false, follow: false } : undefined,
+    openGraph: { type: "article", publishedTime: date, modifiedTime: updated },
+  };
+}
+
+export async function SectionPath({ section, path }: { section: ContentSection; path: string[] }) {
+  const { source, basePath, rootLabel, itemLabel } = section;
+  const resolved = await resolve(section, path);
+
+  if (!resolved) notFound();
+
+  if (resolved.kind === "post") {
+    return (
+      <PostView
+        entry={resolved.entry}
+        source={source}
+        basePath={basePath}
+        rootLabel={rootLabel}
+        backLabel={`All ${itemLabel}s`}
+        authorBasePath={section.authorBasePath}
+      />
+    );
+  }
+
+  const { category, entries, all } = resolved;
+  const label = categoryLabel(category, source.labels);
+  const crumbs = categoryCrumbs(category, basePath, source.labels);
+
+  return (
+    <ContentIndex
+      entries={entries}
+      categories={childCategories(all, category, source.labels)}
+      tags={collectTags(entries)}
+      labels={source.labels}
+      basePath={basePath}
+      activeCategory={category}
+      eyebrow={
+        <Breadcrumbs
+          items={[
+            { label: rootLabel.toLowerCase(), href: basePath },
+            ...crumbs.map((crumb, index) =>
+              index === crumbs.length - 1 ? { label: crumb.label } : crumb,
+            ),
+          ]}
+        />
+      }
+      heading={`${label}.`}
+      intro={`${plural(entries.length, itemLabel)} in ${label}.`}
+      list={section.list}
+      itemLabel={itemLabel}
+    />
+  );
+}
+
+/* ---------- /<section>/tag/<tag> ---------- */
+
+export function tagMetadata(section: ContentSection, tag: string): Metadata {
+  return { title: `${capitalize(section.itemLabel)}s tagged ${decodeURIComponent(tag)}` };
+}
+
+export async function SectionTag({ section, tag }: { section: ContentSection; tag: string }) {
+  const { source, basePath, rootLabel, itemLabel } = section;
+  const all = await listEntries(source);
+  const allTags = collectTags(all);
+  const current = allTags.find((t) => t.slug === tag);
+
+  if (!current) notFound();
+
+  const entries = all.filter((e) => e.meta.tags.some((t) => tagSlug(t) === tag));
+
+  return (
+    <ContentIndex
+      entries={entries}
+      categories={childCategories(all, "", source.labels)}
+      tags={allTags}
+      labels={source.labels}
+      basePath={basePath}
+      activeTag={tag}
+      eyebrow={`${rootLabel.toLowerCase()} / tag / ${tag}`}
+      heading={`${current.name}.`}
+      intro={`${plural(current.count, itemLabel)} tagged ${current.name}.`}
+      list={section.list}
+      itemLabel={itemLabel}
+    />
+  );
+}
diff --git a/components/content/sheet-list.tsx b/components/content/sheet-list.tsx
new file mode 100644
index 0000000..6b795ae
--- /dev/null
+++ b/components/content/sheet-list.tsx
@@ -0,0 +1,232 @@
+"use client";
+
+import { useEffect, useMemo, useRef, useState } from "react";
+import Link from "next/link";
+
+import { motion,MotionConfig } from "framer-motion";
+import { ArrowUpRight, Search, X } from "lucide-react";
+
+import { pillClass } from "@/components/content/chip";
+import { PostCard } from "@/components/content/post-card";
+import { categoryHref, plural } from "@/lib/content-format";
+import { cn } from "@/lib/utils";
+import type { PostSummary } from "@/types/blog";
+
+type Sort = "az" | "newest";
+
+const SORTS: { value: Sort; label: string }[] = [
+  { value: "az", label: "A–Z" },
+  { value: "newest", label: "Newest" },
+];
+
+const reveal = {
+  hidden: { opacity: 0, y: 16 },
+  show: { opacity: 1, y: 0, transition: { duration: 0.5 } },
+};
+
+function Reveal({ children }: { children: React.ReactNode }) {
+  return (
+    <motion.div
+      initial="hidden"
+      whileInView="show"
+      viewport={{ once: true, amount: 0.15 }}
+      variants={reveal}
+    >
+      {children}
+    </motion.div>
+  );
+}
+
+const byTitle = (a: PostSummary, b: PostSummary) => a.title.localeCompare(b.title);
+
+// Undated sheets always sort last.
+const byNewest = (a: PostSummary, b: PostSummary) => {
+  if (!a.date && !b.date) return 0;
+  if (!a.date) return 1;
+  if (!b.date) return -1;
+  return b.date.localeCompare(a.date);
+};
+
+interface Props {
+  posts: PostSummary[];
+  basePath: string;
+  itemLabel: string;
+}
+
+// Reference-style listing: grouped by top-level category, alphabetical by default.
+export function SheetList({ posts, basePath, itemLabel }: Props) {
+  const [query, setQuery] = useState("");
+  const [sort, setSort] = useState<Sort>("az");
+  const inputRef = useRef<HTMLInputElement>(null);
+
+  // "/" focuses the search box, like most docs sites.
+  useEffect(() => {
+    const onKeyDown = (event: KeyboardEvent) => {
+      if (event.key !== "/" || event.metaKey || event.ctrlKey || event.altKey) return;
+
+      const active = document.activeElement;
+      if (
+        active instanceof HTMLElement &&
+        (active.tagName === "INPUT" || active.tagName === "TEXTAREA" || active.isContentEditable)
+      ) {
+        return;
+      }
+
+      event.preventDefault();
+      inputRef.current?.focus();
+    };
+
+    window.addEventListener("keydown", onKeyDown);
+    return () => window.removeEventListener("keydown", onKeyDown);
+  }, []);
+
+  const indexed = useMemo(
+    () =>
+      posts.map((post) => ({
+        post,
+        haystack: [post.title, post.description ?? "", post.categoryName, ...post.tags]
+          .join(" ")
+          .toLowerCase(),
+      })),
+    [posts],
+  );
+
+  const { groups, total } = useMemo(() => {
+    const terms = query.trim().toLowerCase().split(/\s+/).filter(Boolean);
+    const compare = sort === "az" ? byTitle : byNewest;
+
+    const matches = indexed
+      .filter(({ haystack }) => terms.every((term) => haystack.includes(term)))
+      .map(({ post }) => post)
+      .sort(compare);
+
+    if (terms.length > 0) {
+      return { groups: [{ key: "", label: "", posts: matches }], total: matches.length };
+    }
+
+    const byCategory = new Map<string, { label: string; posts: PostSummary[] }>();
+    for (const post of matches) {
+      const group = byCategory.get(post.topCategory) ?? { label: post.topCategoryName, posts: [] };
+      group.posts.push(post);
+      byCategory.set(post.topCategory, group);
+    }
+
+    return {
+      groups: [...byCategory]
+        .map(([key, group]) => ({ key, ...group }))
+        .sort((a, b) => a.label.localeCompare(b.label)),
+      total: matches.length,
+    };
+  }, [indexed, query, sort]);
+
+  return (
+    <MotionConfig reducedMotion="user">
+      <section className="mt-8">
+        <div className="flex flex-wrap items-center gap-3">
+          <label className="shine-border-hover relative block min-w-56 flex-1 rounded-full border border-(--site-surface-border) transition focus-within:border-(--site-accent) sm:max-w-md">
+            <span className="sr-only">Search {itemLabel}s</span>
+            <Search
+              className="pointer-events-none absolute top-1/2 left-4 h-4 w-4 -translate-y-1/2 text-(--site-muted)"
+              aria-hidden="true"
+            />
+            <input
+              ref={inputRef}
+              type="text"
+              inputMode="search"
+              value={query}
+              onChange={(event) => setQuery(event.target.value)}
+              onKeyDown={(event) => event.key === "Escape" && setQuery("")}
+              placeholder={`Search ${itemLabel}s and tags`}
+              className="w-full rounded-full bg-transparent py-2.5 pr-12 pl-11 text-sm text-(--site-text) outline-none placeholder:text-(--site-muted)"
+            />
+            {query ? (
+              <button
+                type="button"
+                aria-label="Clear search"
+                onClick={() => setQuery("")}
+                className="absolute top-1/2 right-3 -translate-y-1/2 rounded-full p-1 text-(--site-muted) hover:text-(--site-text)"
+              >
+                <X className="h-4 w-4" />
+              </button>
+            ) : (
+              <kbd className="pointer-events-none absolute top-1/2 right-4 -translate-y-1/2 rounded border border-(--site-surface-border) px-1.5 text-[10px] text-(--site-muted)">
+                /
+              </kbd>
+            )}
+          </label>
+
+          <div
+            role="group"
+            aria-label="Sort sheets"
+            className={cn(pillClass, "inline-flex p-1 text-sm")}
+          >
+            {SORTS.map((option) => (
+              <button
+                key={option.value}
+                type="button"
+                aria-pressed={sort === option.value}
+                onClick={() => setSort(option.value)}
+                className={cn(
+                  "rounded-full px-3 py-1 transition",
+                  sort === option.value
+                    ? "bg-(--site-accent)/15 site-nav-active"
+                    : "text-(--site-muted) hover:text-(--site-text)",
+                )}
+              >
+                {option.label}
+              </button>
+            ))}
+          </div>
+
+          <p className="ml-auto text-sm resume-muted" aria-live="polite">
+            {plural(total, itemLabel)}
+          </p>
+        </div>
+
+        {total === 0 ? (
+          <div className="mt-12 text-center">
+            <p className="text-lg text-(--site-text)">
+              No {itemLabel}s match &ldquo;{query}&rdquo;.
+            </p>
+            <button
+              type="button"
+              onClick={() => setQuery("")}
+              className="mt-3 text-sm site-nav-active hover:underline"
+            >
+              Clear search
+            </button>
+          </div>
+        ) : (
+          groups.map((group, index) => (
+            <div key={group.key || "results"} className={index === 0 ? "mt-8" : "mt-12"}>
+              {group.label && (
+                <div className="mb-5 flex items-baseline gap-3">
+                  <h2 className="text-3xl font-semibold tracking-tighter text-(--site-text)">
+                    {group.label}
+                  </h2>
+                  <span className="font-mono text-xs resume-muted">
+                    {String(group.posts.length).padStart(2, "0")}
+                  </span>
+                  <Link
+                    href={categoryHref(basePath, group.key)}
+                    className="ml-auto inline-flex items-center gap-1 text-sm site-nav-active hover:underline"
+                  >
+                    View all
+                    <ArrowUpRight className="h-4 w-4" aria-hidden="true" />
+                  </Link>
+                </div>
+              )}
+              <div className="grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
+                {group.posts.map((post) => (
+                  <Reveal key={post.key}>
+                    <PostCard post={post} />
+                  </Reveal>
+                ))}
+              </div>
+            </div>
+          ))
+        )}
+      </section>
+    </MotionConfig>
+  );
+}
