{
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },
  "files.eol": "\n",
  "search.exclude": {
    "**/build": true,
    "**/.next": true,
    "**/node_modules": true,
    "**/pnpm-lock.yaml": true,
    "**/tsconfig.tsbuildinfo": true,
    "public/images": true,
    "public/generated-project-previews": true,
    "public/fonts": true
  },
  "files.watcherExclude": {
    "**/build/**": true,
    "**/.next/**": true,
    "**/node_modules/**": true
  },
  "eslint.useFlatConfig": true,
  "cSpell.words": [
    "calsans",
    "cheatsheet",
    "cheatsheets",
    "contentlayer",
    "countrydetails",
    "cutover",
    "jobtask",
    "netsh",
    "quoteless",
    "sankatmochan",
    "shadcn"
  ]
}
